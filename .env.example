# Documentation only: no real credentials. Production may use test mode first, then live mode after ORANGERANK_LIVE_APPROVED=true.
ORANGERANK_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_ORANGERANK_PRICE_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Exact trusted Preview/local origin; never use request-controlled return URLs.
ORANGERANK_CHECKOUT_ORIGIN=
# Endpoint signing secret for the Stripe mode in use. Sandbox and live secrets differ. Placeholder only.
STRIPE_WEBHOOK_SECRET=
# Receiver for Contract C on sandbox payments and Contract B on live payments.
ORANGERANK_HANDOFF_ENABLED=false
ORANGERANK_HANDOFF_URL=
ORANGERANK_HANDOFF_TOKEN=
# At least 32 characters, server-only auth for internal outbox dispatch. Never in browser.
ORANGERANK_DISPATCH_SECRET=
# Validation-only sender. Leave unset in Production; Contract A stays blocked there.
GROK_ROUTINE_WEBHOOK_URL=
GROK_ROUTINE_WEBHOOK_KEY=

# Preview-only read-only audit identity; distinct from dispatch/Grok/bypass keys.
ORANGERANK_AUDIT_SECRET=
# Preview-only narrowly scoped synthetic test correction; separate operator identity.
ORANGERANK_SANDBOX_CORRECTION_SECRET=
# One-time authenticated replay of a stored Stripe review. Unset except while replaying. Distinct from audit and dispatch secrets. At least 32 characters.
ORANGERANK_REVIEW_REPLAY_SECRET=
# Bearer secret for GET /api/internal/outreach-clicks. At least 32 characters. Distinct from audit, dispatch, review-replay, and sandbox-correction secrets. Never in the browser.
ORANGERANK_OUTREACH_CLICKS_SECRET=
# Explicit test/live separation. Defaults fail closed; existing Preview must add test mode.
ORANGERANK_STRIPE_MODE=
# New checkout stays disabled until separately approved, even if old enabled flag was true.
ORANGERANK_CHECKOUT_RELEASE_APPROVED=false
# Production-only live approval. Never enable without separate cutover authorization.
ORANGERANK_LIVE_APPROVED=false
